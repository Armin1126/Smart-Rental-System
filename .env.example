# Application Environment Variables Template

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/smart_rental_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DRIVER=org.postgresql.Driver

# Spring Boot Backend Config
SERVER_PORT=8080
JPA_DDL_AUTO=update

# FastAPI Analytics Service Config
ANALYTICS_PORT=8000
ANALYTICS_HOST=0.0.0.0

# Vite Frontend Config
VITE_BACKEND_URL=http://localhost:8080/api
VITE_ANALYTICS_URL=http://localhost:8000
